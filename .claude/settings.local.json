{
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(curl:*)",
      "Bash(nslookup:*)",
      "Bash(ping:*)",
      "Bash(wget:*)",
      "Bash(ip route:*)",
      "Read(/etc/**)",
      "Bash(chmod:*)",
      "Bash(git add:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh project create:*)",
      "Bash(gh extension:*)",
      "Bash(gh projects item-add:*)",
      "WebSearch",
      "Bash(mkdir:*)",
      "WebFetch(domain:github.com)",
      "Bash(claude mcp:*)",
      "mcp__o3-search__o3-search",
      "Bash(echo:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws cloudformation describe-stack-resources:*)",

      "Edit",
      "Write",
      "MultiEdit",

      "Bash(aws configure list:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3api list-*:*)",
      "Bash(aws s3api get-*:*)",
      "Bash(aws s3api head-*:*)",
      "Bash(aws lambda list-*:*)",
      "Bash(aws lambda get-*:*)",
      "Bash(aws apigateway get-*:*)",
      "Bash(aws cloudfront list-*:*)",
      "Bash(aws cloudfront get-*:*)",
      "Bash(aws secretsmanager list-secrets:*)",
      "Bash(aws logs describe-*:*)",
      "Bash(aws logs get-*:*)",
      "Bash(aws logs filter-*:*)",

      "Bash(terraform init:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform version:*)",
      "Bash(terraform output:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [],
    "ask": []
  },
  "env": {
    "AWS_PROFILE": "dev",
    "AWS_DEFAULT_REGION": "ap-northeast-1"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "o3-search"
  ]
}
